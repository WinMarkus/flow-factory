# ---------------------------------------------------------------------------
# Flow Factory - server-side environment variables
# Copy to .env for local development. Never commit a real token.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on. Render sets this automatically.
PORT=3000

# Set to "production" on a deployed instance.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Optional: saving the retro JSON to GitHub.
# If these are missing the game stays fully playable and Markus gets the
# "Download JSON" fallback instead.
# ---------------------------------------------------------------------------

# Fine-grained personal access token with ONLY "Contents: Read and write"
# on the target repository. Server-side only - never sent to the browser.
GITHUB_TOKEN=

# Owner of the repository the snapshots are committed to (user or org).
GITHUB_OWNER=

# Repository name, without the owner prefix.
GITHUB_REPO=

# Branch that receives the commit. Defaults to main when empty.
GITHUB_BRANCH=main
