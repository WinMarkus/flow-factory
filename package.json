{
  "name": "flow-factory",
  "version": "1.0.0",
  "description": "Flow Factory - a cooperative factory-management retrospective for distributed software teams.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "dev": "npm run build && node --enable-source-maps dist/server/index.js",
    "test": "npm run build:server && node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
